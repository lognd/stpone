BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never

ColumnLimit: 100

BreakBeforeBraces: Attach

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: false

PointerAlignment: Left

NamespaceIndentation: All

SortIncludes: true

Standard: c++20\n\n# frob: directive comments must stay on one line.\nReflowComments: false\n